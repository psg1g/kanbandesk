# Скопируйте в .env и заполните своими значениями. НЕ коммитьте .env!
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=0
# В ALLOWED_HOSTS хост пишется БЕЗ схемы, с портом можно: 185.148.216.201,185.148.216.201:8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.ru
# В CSRF_TRUSTED_ORIGINS каждый элемент ОБЯЗАТЕЛЬНО со схемой http:// или https://
# (Django 4+ не принимает голый 'ip:port'). Пример для IP:8080:
CSRF_TRUSTED_ORIGINS=http://your-domain.ru,http://localhost
DB_NAME=kanban
DB_USER=kanban
DB_PASSWORD=strong-db-password
DB_HOST=db
DB_PORT=5432
MEDIA_ROOT=/app/uploads
MAX_UPLOAD_MB=10

# Наружный HTTP-порт nginx. Если 80 занят — поставьте 8080
# и добавьте "IP:8080" в DJANGO_ALLOWED_HOSTS и CSRF_TRUSTED_ORIGINS выше.
HTTP_PORT=8080
